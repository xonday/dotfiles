#!/bin/sh
#!/bin/sh

cache="${XDG_CACHE_HOME:-$HOME/.cache}/brightness"
buscache="${XDG_CACHE_HOME:-$HOME/.cache}/ddcbus"

# --- backend detection -------------------------------------------------
ddcbus() {
    [ -s "$buscache" ] && read -r b < "$buscache" && { echo "$b"; return; }
    b=$(ddcutil detect 2>/dev/null | sed -n 's/.*I2C bus: *\/dev\/i2c-\([0-9]*\).*/\1/p' | head -n1)
    [ -n "$b" ] && echo "$b" > "$buscache" && echo "$b"
}

get() {
    # laptop: kernel backlight
    for d in /sys/class/backlight/*/; do
        [ -r "$d/brightness" ] || continue
        read -r curr < "$d/brightness"
        read -r max  < "$d/max_brightness"
        [ "${max:-0}" -gt 0 ] 2>/dev/null || continue
        echo $((100 * curr / max))
        return
    done
    # desktop: DDC/CI over the monitor cable (slow, so cache it)
    bus=$(ddcbus) || return
    [ -n "$bus" ] || return
    ddcutil --bus "$bus" getvcp 10 2>/dev/null |
        sed -n 's/.*current value = *\([0-9]*\).*/\1/p'
}

case $BLOCK_BUTTON in
    1)
        ;;
    3)
        notify-send "󰃞 Brightness module" "\- Shows current brightness level 󰃞."
        ;;
    6)
        setsid -f "$TERMINAL" -e "$EDITOR" "$0"
        ;;
esac

# sysfs is instant; ddcutil isn't, so only that path leans on the cache
if [ -r /sys/class/backlight ] && [ -n "$(echo /sys/class/backlight/*/brightness)" ] &&
   [ -e "$(echo /sys/class/backlight/*/brightness | cut -d' ' -f1)" ]; then
    brightness_per=$(get)
else
    brightness_per=$(get)
    [ -n "$brightness_per" ] && echo "$brightness_per" > "$cache"
    [ -n "$brightness_per" ] || { [ -s "$cache" ] && read -r brightness_per < "$cache"; }
fi

if [ "$(pgrep gammastep 2>/dev/null)" ]; then
    icon="󰃝" && color="#eba0ac"
else
    icon="󰃞" && color="#f9e2af"
fi

if [ -n "$brightness_per" ]; then
    echo "^lm(nightlight)^fg($color)$icon ^fg()${brightness_per}%^fg()^lm()"
else
    echo "^lm(nightlight)^fg($color)$icon ^fg() ?% ^fg()^lm()"
fi
